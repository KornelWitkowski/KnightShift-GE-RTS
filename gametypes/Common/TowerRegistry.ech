unitex uTowerRegistry[];

#define TOWER_REGISTRY_SIZE 256

function void InitTowerRegistry()
{
    if(uTowerRegistry.GetSize() != 0)
        return;

    uTowerRegistry.Create(TOWER_REGISTRY_SIZE);
}

function int AddTowerToRegistry(unitex uTower)
{
    int i;
    unitex uTowerInRegistry;

    if(uTowerRegistry.GetSize() == 0)
        InitTowerRegistry();

    for(i = 0; i < TOWER_REGISTRY_SIZE; ++i)
    {
        uTowerInRegistry = uTowerRegistry[i];
        if((uTowerInRegistry == null) || (!uTowerInRegistry.IsLive()))
        {
            uTowerRegistry[i] = uTower;
            return true;
        }
    }
    return false;
}

function void CleanupTowerRegistry()
{
    int iTop, iLeft, iRight, iBottom;
    int iX, iY;
    unitex uTowerInRegistry;
    int i;

    if(uTowerRegistry.GetSize() == 0)
        InitTowerRegistry();

    for(i = 0; i < TOWER_REGISTRY_SIZE; ++i)
    {
        uTowerInRegistry = uTowerRegistry[i];

        if(uTowerInRegistry == null)
            continue;

        if(!uTowerInRegistry.IsLive())
        {
            uTowerRegistry[i] = null;
            continue;
        }


        iTop = GetTop() + 25;
        iLeft = GetLeft() + 25;

        iRight = GetRight() - 25;
        iBottom = GetBottom() - 25;

        iX = uTowerInRegistry.GetLocationX();
        iY = uTowerInRegistry.GetLocationY();

        if((iX < iLeft) || (iX > iRight) || (iY < iTop) || (iY > iBottom))
        {
            uTowerRegistry[i] = null;
            continue;
        }
    }
}


function void CheckBuildingCreated(unitex uBuildingCreated)
{
    if(uTowerRegistry.GetSize() == 0)
        InitTowerRegistry();

    if(uBuildingCreated.GetBuildingType() == buildingTower)
        AddTowerToRegistry(uBuildingCreated);
    else if(uBuildingCreated.GetBuildingType() == buildingGate)
    {
        // omijamy bramy automatyczne przez odrzucenie wszystkich niezniszczalnych bram :)
        if(uBuildingCreated.GetArmour(1) == 100)
            return;

        AddTowerToRegistry(uBuildingCreated);
    }
    else if(uBuildingCreated.GetBuildingType() == buildingBridgeGate)
    {
        // omijamy bramy automatyczne przez odrzucenie wszystkich niezniszczalnych bram :)
        if(uBuildingCreated.GetArmour(1) == 100)
            return;

        AddTowerToRegistry(uBuildingCreated);
    }
    else
        return;
}

function int GetNumberOfTowersInRegistry()
{
    int i;
    int iCount;

    iCount = 0;
    for(i = 0; i < TOWER_REGISTRY_SIZE; ++i)
    {
        if(uTowerRegistry[i] != null)
            iCount = iCount + 1;
    }
    return iCount;
}

function unitex FindClosestEmptyTower(unitex uUnit)
{
    int i;
    int iX, iY, iXBase, iYBase;
    int iDistanceTowerToUnit, iDistanceTowerToBase, iDistance, iDistanceBest;
    unitex uTower, uTowerClosest;
    player rPlayer;

    if(uTowerRegistry.GetSize() == 0)
        return null;

    iDistanceBest = 1000000;

    rPlayer = GetPlayer(uUnit.GetIFFNumber());
    iXBase = rPlayer.GetStartingPointX();
    iYBase = rPlayer.GetStartingPointY();

    for(i = 0; i < TOWER_REGISTRY_SIZE; ++i)
    {
        uTower = uTowerRegistry[i];
        if(uTower == null)
            continue;

        if(uTower.HaveUnitOnTower())
            continue;

        // // bierzemy wejście do wieży            
        iX = uTower.GetLocationX() - GetXInFront(uTower.GetAlphaAngle());
        iY = uTower.GetLocationY() - GetYInFront(uTower.GetAlphaAngle());

        iDistanceTowerToUnit = uTower.DistanceTo(uUnit.GetUnitRef());
        iDistanceTowerToBase = uTower.DistanceTo(iXBase, iYBase);

        if((iDistanceTowerToBase > 20) && !rPlayer.IsPointLocated(iX, iY))
            continue;

        iDistance = (
            3 * iDistanceTowerToUnit + 
            Power(iDistanceTowerToUnit, 2)/5 + 
            iDistanceTowerToBase + 
            Power(iDistanceTowerToBase, 2)/10
        );

        // niskie prawdopodbienstwo wysłania unita do dalekich obiektów
        if(RandXor(iDistance + 10) > 5)
            continue;

        if(iDistance < iDistanceBest)
        {
            if(!IsPathAccessible(uUnit, iX, iY))
                continue;

            uTowerClosest = uTower;
            iDistanceBest = iDistance;
        }
    }

    return uTowerClosest;
}

function void TakeEmptyTowers(player rPlayer)
{
    int i, iNumberOfUnits;
    int bIsShooter;
    int iCount;
    unitex uUnit;
    unitex uTower;

    iCount = 0;
    iNumberOfUnits = rPlayer.GetNumberOfUnits();

    for(i = 0; i < iNumberOfUnits; ++i)
    {
        uUnit = rPlayer.GetUnit(i);
        if(uUnit == null)
            continue;

        bIsShooter = IsShooter(uUnit);

        if(Rand(20) != 0)
            continue;

        if(!bIsShooter)
            continue;

        if(uUnit.IsMoving())
            continue;

        if(uUnit.IsFlyable())
            continue;

        if(uUnit.IsInTower())
            continue;

        if(IsUnitAttacking(uUnit) && RandXor(10) != 0)
            continue;

        uTower = FindClosestEmptyTower(uUnit);
        if(uTower == null)
            continue;

        uUnit.CommandEnter(uTower);
        iCount = iCount + 1;

        if(iCount >= 2)
            return;
    }
}