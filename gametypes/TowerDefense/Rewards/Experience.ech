

function unitex RewardExperience(int iWaveNumber, int iMarker)
{
    int i, iType;
    unitex uItem;

    i = RandXorNoExtraEntropy(100) + 2 * iWaveNumber;

    if(i < 40)
        iType = 0;
    else if(i < 80)
        iType = 1;
    else if(i < 120)
        iType = 2;
    else if(i < 160)
        iType = 3;
    else
        iType = 4;

    i = RandXorNoExtraEntropy(100);
    if(i < 8)
        uItem = CreateResistanceArtefact(iMarker, FIRST_REWARD_MARKER);
    else if(i < 31) // 23% szans na bonus HP do budynków (daje średnio +50% HP na 25 falę)
    {
        iType = RandXorNoExtraEntropy(3); // 1/3 szans na każdy z tierów (5%, 10%, 20%)
        uItem = CreateBuildingHpArtefact(iMarker, FIRST_REWARD_MARKER, iType);
    }
    else
        uItem = CreateExperienceArtefact(iMarker, FIRST_REWARD_MARKER, iType);

    return uItem;
}