function int ChooseEquipmentTier(int iWaveNumber)
{
    int i;
    int j;
    int iRolls;
    int iMinRoll;
    int iCandidate;
    int iBest;
    int iRoll;

    /* Best-of-N: im dalsza fala, tym więcej rzutów, bierzemy najlepszy.
       Waves 0-11 -> 1 rzut, 12-23 -> 2, 24-35 -> 3, 36+ -> 4.
       Dzięki temu ogon najsłabszych wyników kurczy się płynnie z falą,
       a top-tier staje się realnie osiągalny w późnej grze bez gwarancji. */
    iRolls = 1 + iWaveNumber / 12;
    if (iRolls > 4) iRolls = 4;

    /* Progresywny floor. Do fali 9 brak floora.
       Potem co ~10 fal odcinamy kolejny koszyk (tier 0, potem 0-1, 0-2, 0-3).
       Cap na 55, żeby zostawić losowość w środku gry i nie wymuszać top-tieru. */
    iMinRoll = 0;
    if (iWaveNumber >= 10) iMinRoll = 15;
    if (iWaveNumber >= 15) iMinRoll = 25;
    if (iWaveNumber >= 25) iMinRoll = 35;
    if (iWaveNumber >= 35) iMinRoll = 45;
    if (iWaveNumber >= 45) iMinRoll = 55;

    iBest = -999;
    iCandidate = 0;
    for (i = 0; i < iRolls; ++i)
    {
        /* Reroll gdy rzut poniżej floora; limit 8 iteracji zabezpiecza
           przed zapętleniem w skrajnych przypadkach. */
        for (j = 0; j < 8; ++j)
        {
            iCandidate = GaussianDistributionNoExtraEntropy(35) + (3 * iWaveNumber / 2);
            if (iCandidate >= iMinRoll) break;
        }
        if (iCandidate > iBest) iBest = iCandidate;
    }
    iRoll = iBest;

    if (25 > iRoll) return 0;
    if (35 > iRoll) return 1;
    if (45 > iRoll) return 2;
    if (55 > iRoll) return 3;
    if (65 > iRoll) return 4;
    if (75 > iRoll) return 5;
    if (85 > iRoll) return 6;
    if (95 > iRoll) return 7;
    if (105 > iRoll) return 8;
    return 9;
}

function unitex CreateBowReward(int iWaveNumber, int iMarker)
{
    int iX, iY, iZ;
    int iRand, iTier;
    unitex uBow;

    iX = GetPointX(iMarker);
    iY = GetPointY(iMarker);
    iZ = GetPointZ(iMarker);
    iRand = RandXorNoExtraEntropy(5);

    iTier = ChooseEquipmentTier(iWaveNumber);

    if (iTier == 0)
    {
        uBow = CreateArtefact("ART_BOW5", iX, iY, iZ, 0);
    }
    else if (iTier == 1)
    {
        uBow = CreateArtefact("ART_BOW6", iX, iY, iZ, 0);
    }
    else if (iTier == 2)
    {
        uBow = CreateArtefact("ART_BOW7", iX, iY, iZ, 0);
    }
    else if (iTier == 3)
    {
        uBow = CreateArtefact("ART_BOW8", iX, iY, iZ, 0);
    }
    else if (iTier == 4)
    {
        uBow = CreateArtefact("ART_BOW9", iX, iY, iZ, 0);
    }    
    else if (iTier == 5)
    {
        uBow = CreateArtefact("ART_BOW10", iX, iY, iZ, 0);
    }
    else if (iTier == 6)
    {
        uBow = CreateArtefact("ART_BOW11", iX, iY, iZ, 0);
    }
    else if (iTier == 7)
    {
        uBow = CreateArtefact("ART_BOW12", iX, iY, iZ, 0);
    }
    else if (iTier == 8)
    {
        uBow = CreateArtefact("ART_BOW13", iX, iY, iZ, 0);
    }
    else if (iTier == 9)
    {
        uBow = CreateArtefact("ART_BOW14", iX, iY, iZ, 0);
    }

    return uBow;
}

