function unitex SpawnWitchBoss(int nWaveNumber, int iMarker)
{
    int iX, iY, iZ, iAngle;
    unitex uUnit;

    uUnit = CreateUnitAtMarker(rPlayer10, iMarker, "TD_WITCH_BOSS");
    
    if(nWaveNumber <= 10)
    {
        uUnit.AddHP(-3000);
    }
    else if(nWaveNumber <= 20)
    {
       uUnit.AddHP(-1500);
    }
    else if(nWaveNumber <= 30)
    {
;
    }
    else if(nWaveNumber <= 40)
    {
        uUnit.AddHP(1500);
    }
    else
    {
        uUnit.AddHP(3000);
    }

    GiveCaptureConvertResistance(uUnit);
    SetUnitMaskedScriptData(uUnit, PATH_MASK, FIRST_MARKER_TO_REACH_CENTER);
    uUnit.CommandSetMakeMagicTeleportationMode(true);
    SetUnitMaskedScriptData(uUnit, TOWER_DEFENSE_SPECIAL_MASK, MAGE_MARKER);
    CreateObjectAtUnit(uUnit, "HIT_GHOST");

    return uUnit;
}