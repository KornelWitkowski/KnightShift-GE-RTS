
function unitex SpawnTitanBoss(int nWaveNumber, int iMarker)
{
    int iX, iY, iZ, iAngle;
    unitex uUnit;
    
    if(nWaveNumber <= 10)
    {
        uUnit = CreateUnitAtMarker(rPlayer10, iMarker, "TD_TITAN_BOSS");
    }
    else if(nWaveNumber <= 20)
    {
        uUnit = CreateUnitAtMarker(rPlayer10, iMarker, "TD_TITAN_BOSS");
        uUnit.AddHP(1500);
        uUnit.AddDamage(0, 30);
        uUnit.AddDamage(1, 30);
        uUnit.AddDamage(2, 30);
    }
    else if(nWaveNumber <= 30)
    {
        uUnit = CreateUnitAtMarker(rPlayer10, iMarker, "TD_TITAN_BOSS");
        uUnit.AddHP(3000);
        uUnit.AddDamage(0, 60);
        uUnit.AddDamage(1, 60);
        uUnit.AddDamage(2, 60);
    }
    else
    {
        uUnit = CreateUnitAtMarker(rPlayer10, iMarker, "TD_TITAN_BOSS");
        uUnit.AddHP(5000);
        uUnit.AddDamage(0, 100);
        uUnit.AddDamage(1, 100);
        uUnit.AddDamage(2, 100);
    }

    GiveCaptureConvertResistance(uUnit);
    SetUnitMaskedScriptData(uUnit, PATH_MASK, FIRST_MARKER_TO_REACH_CENTER);
    CreateObjectAtUnit(uUnit, "HIT_GHOST");

    return uUnit;
}